[Unit]
Description=Dump the lab gateway's database to the backup bucket
Requires=labllm-postgres.service
After=labllm-postgres.service network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/labllm/backup.env
Environment=PATH=/usr/local/bin:/snap/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/labllm-dump
